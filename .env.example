DATABASE_URL=postgresql+psycopg2://zyra:zyra_password@localhost:5432/zyra
SECRET_KEY=change-me-in-prod
REFRESH_SECRET_KEY=change-me-in-prod-refresh
PEPPER=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ATTEMPTS=5

# OpenAI (or any OpenAI-compatible endpoint)
# Leave OPENAI_BASE_URL empty to use https://api.openai.com/v1
OPENAI_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_CHECK_CTX_LENGTH=true
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional external inference; core coach APIs work without it.
AI_EXTERNAL_ENABLED=false
AI_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=800
# Optional taxonomy extensions and deterministic keyword rules (JSON).
CATEGORY_EXTRA_LABELS=[]
CATEGORY_KEYWORD_RULES={}

# Notification delivery infrastructure (AI-15M)
# Default development and test behavior is non-delivery (in-memory test backend).
NOTIFICATION_DELIVERY_ENABLED=false
EMAIL_BACKEND=test
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_SENDER_ADDRESS=notifications@porerhishab.com
EMAIL_SENDER_NAME=PorerHishab
FRONTEND_BASE_URL=http://localhost:5173
NOTIFICATION_MAX_RETRIES=3


# Deployment mode: development, test, or production.
APP_ENV=development
# JSON array, not a comma-separated list. Production requires an explicit,
# nonempty list; credentials cannot be used with wildcard origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true

# Production: use a separate protected file outside the repository, passed with
# docker compose --env-file /protected/production.env -f docker-compose.prod.yml.
# Set APP_ENV=production and PRODUCTION_ENV_FILE to that same absolute file path.
# Supply DATABASE_URL=postgresql+psycopg2://<user>:<URL-encoded-password>@db:5432/<db>
# POSTGRES_DB and POSTGRES_USER default to porerhishab; POSTGRES_PASSWORD is required.
# Replace SECRET_KEY, REFRESH_SECRET_KEY and PEPPER with three distinct random
# values of at least 32 characters. Never use the development placeholders above.
# Set CORS_ORIGINS=["https://your-frontend.example"] and FRONTEND_BASE_URL to the
# real public frontend URL. API_PORT defaults to 8000, bound only to loopback.
# Keep NOTIFICATION_DELIVERY_ENABLED=false, EMAIL_BACKEND=test, and
# AI_EXTERNAL_ENABLED=false through this stage. Later real email enablement
# requires EMAIL_BACKEND=smtp and a configured non-local SMTP_HOST.
# Do not paste real production secrets into this example.
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_RETRY_MAX_DELAY_SECONDS=3600
NOTIFICATION_RETRY_JITTER_SECONDS=10
SMTP_TIMEOUT_SECONDS=10
