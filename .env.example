DATABASE_URL=postgresql+psycopg2://zyra:zyra_password@localhost:5432/zyra
SECRET_KEY=change-me-in-prod
REFRESH_SECRET_KEY=change-me-in-prod-refresh
PEPPER=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ATTEMPTS=5

# OpenAI (or any OpenAI-compatible endpoint)
# Leave OPENAI_BASE_URL empty to use https://api.openai.com/v1
OPENAI_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_CHECK_CTX_LENGTH=true
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional external inference; core coach APIs work without it.
AI_EXTERNAL_ENABLED=false
AI_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=800
# Optional taxonomy extensions and deterministic keyword rules (JSON).
CATEGORY_EXTRA_LABELS=[]
CATEGORY_KEYWORD_RULES={}
